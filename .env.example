# Servidor
PORT=3000

# Hace falta al menos un canal: Telegram o WhatsApp. Si defines alguna variable de un canal, define todas las suyas.

# Telegram (canal activo mientras llega el teléfono de WhatsApp)
TELEGRAM_BOT_TOKEN=             # lo entrega @BotFather al crear el bot
TELEGRAM_WEBHOOK_SECRET=        # texto que tú inventas; solo A-Z a-z 0-9 _ - (máx. 256)
TELEGRAM_ALLOWED_IDS=           # ids de Telegram autorizados, separados por coma. Vacío = nadie (el bot responde el id a quien le escriba)
# PUBLIC_URL=                   # opcional; Render ya aporta RENDER_EXTERNAL_URL y con él el servidor registra solo el webhook

# WhatsApp Cloud API (Meta) — pendiente hasta tener el número
WHATSAPP_VERIFY_TOKEN=          # texto que tú inventas; se pega igual en la configuración del webhook
WHATSAPP_APP_SECRET=            # App Secret de la app de Meta (valida la firma del webhook)
WHATSAPP_ACCESS_TOKEN=          # token de usuario del sistema
WHATSAPP_PHONE_NUMBER_ID=       # id del número que envía las respuestas
WHATSAPP_GRAPH_VERSION=v21.0

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=      # solo en el servidor, nunca en un cliente
SUPABASE_BUCKET=papeleo-documentos

# IA (lectura de facturas)
ANTHROPIC_API_KEY=
EXTRACTION_MODEL=claude-opus-5-5

# Google Sheets (opcional). JSON de la cuenta de servicio, tal cual o en base64.
GOOGLE_SERVICE_ACCOUNT_JSON=
