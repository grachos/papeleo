# Servidor
PORT=3000

# Hace falta al menos un canal: Instagram o WhatsApp. Si defines alguna variable de un canal, define todas las suyas.

# Instagram (mensajes directos). Canal activo mientras llega el teléfono de WhatsApp.
INSTAGRAM_ACCESS_TOKEN=         # token de la cuenta profesional de Instagram
INSTAGRAM_APP_SECRET=           # App Secret (valida la firma del webhook); si se omite, usa WHATSAPP_APP_SECRET
INSTAGRAM_VERIFY_TOKEN=         # texto que tú inventas; si se omite, usa WHATSAPP_VERIFY_TOKEN
INSTAGRAM_GRAPH_VERSION=v21.0

# WhatsApp Cloud API (Meta) — pendiente hasta tener el número
WHATSAPP_VERIFY_TOKEN=          # texto que tú inventas; se pega igual en la configuración del webhook
WHATSAPP_APP_SECRET=            # App Secret de la app de Meta (valida la firma del webhook)
WHATSAPP_ACCESS_TOKEN=          # token de usuario del sistema
WHATSAPP_PHONE_NUMBER_ID=       # id del número que envía las respuestas
WHATSAPP_GRAPH_VERSION=v21.0

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=      # solo en el servidor, nunca en un cliente
SUPABASE_BUCKET=papeleo-documentos

# IA (lectura de facturas)
ANTHROPIC_API_KEY=
EXTRACTION_MODEL=claude-opus-5-5

# Google Sheets (opcional). JSON de la cuenta de servicio, tal cual o en base64.
GOOGLE_SERVICE_ACCOUNT_JSON=
