{
  "name": "papeleo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Plataforma de papeleo por WhatsApp: módulo de gastos",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
